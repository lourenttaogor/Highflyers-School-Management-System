MONGODB_URI=mongodb://127.0.0.1:27017/highflyers
JWT_SECRET=change-me-to-a-long-random-string
# Email alerts (resend.com) and SMS alerts (termii.com) - both optional
RESEND_API_KEY=
FROM_EMAIL=High Flyers Academy <noreply@yourdomain.com>
TERMII_API_KEY=
TERMII_SENDER=HighFlyers
# School location (optional) - lets the admin see if a clock-in happened away from school
SCHOOL_LAT=
SCHOOL_LNG=
SCHOOL_RADIUS_M=300
